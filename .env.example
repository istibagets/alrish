# Copy to .env (never commit .env)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=alrish_inventory
DB_USER=root
DB_PASS=

# Used ONCE to create the first accounts when the users table is empty.
# Afterwards manage passwords with:  php set_password.php <admin|user> <password>
INITIAL_ADMIN_PASSWORD=
INITIAL_USER_PASSWORD=
